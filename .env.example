# Gemini API kaliti (majburiy) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot tokeni (@BotFather) — bot ishlatilmasa bo'sh qoldiring
TELEGRAM_BOT_TOKEN=

# Bot backend'ga qanday manzilda murojaat qiladi
# (docker-compose ichida: http://backend:8003)
API_BASE=http://127.0.0.1:8003

# Bot foydalanuvchilarini alohida hisoblash uchun umumiy sir (ixtiyoriy,
# lekin tavsiya etiladi). Bo'sh bo'lsa barcha bot so'rovlari bitta IP
# sifatida hisoblanadi.
INTERNAL_TOKEN=

# ---- Navbat / bir vaqtdagi ishlar ----
# Har bir ish bitta Chromium instansiyasini ishga tushiradi (~300-500MB).
# 8GB Contabo VPS / 4CPU uchun 3 xavfsiz (4 ga ko'tarish mumkin). 4GB uchun 2.
MAX_CONCURRENT_JOBS=3
MAX_QUEUE=12
# Tayyor fayl qancha vaqt saqlanadi (soniya)
FILE_TTL_SECONDS=3600
# ETA hisobi (qo'pol taxmin, o'zgartirish shart emas)
# ETA_BASE_SECONDS=25
# ETA_PER_SLIDE_SECONDS=3

# ---- Foydalanuvchi limitlari (0 = o'chiq) ----
# Bitta foydalanuvchi uchun daqiqalik limit (bitta ish ~30-60s — 2 ta/daq
# xatosiz sinash uchun qulay)
RATE_PER_MINUTE=2
RATE_PER_HOUR=0
# Bitta foydalanuvchi uchun kunlik limit (asosiy, bepul kvota)
RATE_PER_DAY=3

# Har bir muvaffaqiyatli referal (do'st taklif qilib, u botdan birinchi
# marta foydalanganda) uchun taklif qiluvchiga qo'shiladigan doimiy
# bonus limit (kunlik limitga qo'shiladi, har kuni qayta tiklanadi)
REFERRAL_BONUS_PER_INVITE=2
# Bitta foydalanuvchi referal orqali eng ko'pi bilan qancha bonus limit
# to'play olishi mumkin (cheksiz taklif = cheksiz limit bo'lib qolmasligi
# uchun; 0 = cheksiz)
REFERRAL_BONUS_MAX=10
# Butun servis uchun daqiqalik limit: 4CPU/8GB + 3 parallel ish bilan
# real o'tkazuvchanlik ~5-6 taqdimot/daqiqa (Gemini LLM ~20-25s har biriga)
RATE_GLOBAL_PER_MINUTE=8
# Butun servis uchun kunlik limit (Gemini free ~1500 so'rov/kun)
RATE_GLOBAL_PER_DAY=600

# Tayyor PDFlar katalogi (docker ichida /tmp ishlatiladi)
# OUTPUT_DIR=/tmp/slide_outputs
